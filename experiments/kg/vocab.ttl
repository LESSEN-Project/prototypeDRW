d:TShirts a drw:ProductCategory ; rdfs:label "t-shirts"@nl ; drw:subcategoryOf d:Tops ; skos:altLabel "shirts"@nl .
d:Polos a drw:ProductCategory ; rdfs:label "polo's"@nl ; drw:subcategoryOf d:Tops .
d:Blouses a drw:ProductCategory ; rdfs:label "blouses"@nl ; drw:subcategoryOf d:Tops .
