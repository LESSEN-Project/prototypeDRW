@prefix drw:  <https://derodewinkel.nl/kg/schema#> .
@prefix d:    <https://derodewinkel.nl/kg/data#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Controlled vocabulary: the individuals every document file refers to.
# Hand-written 2026-09-21. skos:altLabel carries the customer's wording for
# entity linking; rdfs:label is the canonical Dutch name.

### The shop and its channels
d:DeRodeWinkel a drw:Shop ; rdfs:label "De Rode Winkel"@nl ; skos:altLabel "jullie"@nl , "de winkel"@nl , "DRW"@nl .
d:Webshop a drw:Channel ; rdfs:label "webshop"@nl ; skos:altLabel "online"@nl , "de site"@nl , "website"@nl , "op de site"@nl .
d:Store a drw:Channel , drw:Store ; rdfs:label "fysieke winkel in Utrecht"@nl ;
    skos:altLabel "winkel"@nl , "in de winkel"@nl , "vestiging"@nl , "jullie winkel"@nl .
d:WhatsApp a drw:Channel ; rdfs:label "WhatsApp"@nl .
d:Email a drw:Channel ; rdfs:label "e-mail"@nl ; skos:altLabel "mail"@nl .
d:Phone a drw:Channel ; rdfs:label "telefoon"@nl ; skos:altLabel "bellen"@nl .

### Audiences
d:Women a drw:Audience ; rdfs:label "dames"@nl ; skos:altLabel "vrouwen"@nl .
d:Men   a drw:Audience ; rdfs:label "heren"@nl ; skos:altLabel "mannen"@nl .
d:Kids  a drw:Audience ; rdfs:label "kids"@nl ; skos:altLabel "kinderen"@nl .

### Product category tree (subcategoryOf is transitive; sells goes up, appliesTo and doesNotSell go down)
d:Product a drw:ProductCategory ; rdfs:label "product"@nl .
d:Clothing a drw:ProductCategory ; rdfs:label "kleding"@nl ; drw:subcategoryOf d:Product ; skos:altLabel "kleren"@nl .
d:Accessories a drw:ProductCategory ; rdfs:label "accessoires"@nl ; drw:subcategoryOf d:Product .
d:Shoes a drw:ProductCategory ; rdfs:label "schoenen"@nl ; drw:subcategoryOf d:Product .
d:Sneakers a drw:ProductCategory ; rdfs:label "sneakers"@nl ; drw:subcategoryOf d:Shoes .
d:Electronics a drw:ProductCategory ; rdfs:label "elektronica"@nl ; drw:subcategoryOf d:Product .
d:Laptops a drw:ProductCategory ; rdfs:label "laptops"@nl ; drw:subcategoryOf d:Electronics .
d:WhiteGoods a drw:ProductCategory ; rdfs:label "witgoed"@nl ; drw:subcategoryOf d:Product .
d:WashingMachines a drw:ProductCategory ; rdfs:label "wasmachines"@nl ; drw:subcategoryOf d:WhiteGoods .
d:CareProducts a drw:ProductCategory ; rdfs:label "verzorgingsproducten"@nl ; drw:subcategoryOf d:Product .
d:Detergent a drw:ProductCategory ; rdfs:label "wasmiddel"@nl ; drw:subcategoryOf d:CareProducts .
d:SecondHandClothing a drw:ProductCategory ; rdfs:label "tweedehands kleding"@nl ; drw:subcategoryOf d:Clothing .

d:Trousers a drw:ProductCategory ; rdfs:label "broeken"@nl ; drw:subcategoryOf d:Clothing ; skos:altLabel "broek"@nl , "pantalon"@nl , "pants"@nl .
d:Jeans a drw:ProductCategory ; rdfs:label "jeans"@nl ; drw:subcategoryOf d:Trousers ;
    skos:altLabel "spijkerbroek"@nl , "spijkerbroeken"@nl , "denim"@nl .
# Brand lines: the jeans of one brand, so brand questions reach the category tree.
d:LevisJeans a drw:ProductCategory ; rdfs:label "Levi's jeans"@nl ; drw:subcategoryOf d:Jeans ; drw:ofBrand d:Levis ;
    skos:altLabel "mijn Levi's"@nl , "een Levi's"@nl .
d:NudieJeansJeans a drw:ProductCategory ; rdfs:label "Nudie jeans"@nl ; drw:subcategoryOf d:Jeans ; drw:ofBrand d:NudieJeans ;
    skos:altLabel "mijn Nudie"@nl .
d:GStarJeans a drw:ProductCategory ; rdfs:label "G-Star jeans"@nl ; drw:subcategoryOf d:Jeans ; drw:ofBrand d:GStarRAW .
d:DieselJeans a drw:ProductCategory ; rdfs:label "Diesel jeans"@nl ; drw:subcategoryOf d:Jeans ; drw:ofBrand d:Diesel .
